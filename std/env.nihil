// =============================================================================
// std/env.nihil — the configuration: the .env file of the folder the program runs in
// (KEY=value lines; # starts a comment; quotes around a value are dropped), and over
// it the process's environment, so `SERVER_PORT=8741 ./bin/server` wins for one run.
// Include it with @ "std:env.nihil"; (SPEC §16). .env stays on the machine; .env.example lists the keys.
// =============================================================================

ENV_VALUES = {"": "" ; 128};
ENV_LOADED = false;

load_env() {
    ENV_LOADED = true;
    __t? = @? ".env";
    __lines = (__t || "").split("\n");
    __i = 0;
    * __i < #__lines {
        __l = __lines[__i].trim();
        __eq? = __l.find("=");
        #__l > 0 && !__l.starts_with("#") && __eq != _ {
            __key = __l.slice(0, __eq || 0).trim();
            __value = __l.slice((__eq || 0) + 1).trim();
            #__value >= 2 && (__value.starts_with("\"") && __value.ends_with("\"") || __value.starts_with("'") && __value.ends_with("'")) {
                __value = __value.slice(1, #__value - 1);
            }
            ENV_VALUES[__key] = __value;
        }
        __i = __i + 1;
    }
    __proc = (@ "/proc/self/environ").split("\0");
    __i = 0;
    * __i < #__proc {
        __eq? = __proc[__i].find("=");
        __eq != _ { ENV_VALUES[__proc[__i].slice(0, __eq || 0)] = __proc[__i].slice((__eq || 0) + 1); }
        __i = __i + 1;
    }
}

// the value of a key, or the default when it is not set (or set to nothing)
env(key = "", default = "") {
    !ENV_LOADED { load_env(); }
    __v? = ENV_VALUES[key];
    __v == _ || (__v || "") == "" { : default; }
    : __v || "";
}

env_int(key = "", default = 0) {
    : env(key, $default).int() || default;
}
