3 { >> "a"; } >> "\n";
n = 4;
n { >> "b"; } >> "\n";
n * 2 - 1 { >> "c"; } >> "\n";
0 { >> "never"; }
-5 { >> "never"; }
z = 0;
z {}
a = 5;
a {}
// the count is read once: changing the variable inside does not change it
k = 3;
k { k = k + 10; >> "."; }
>> k; >> "\n";
// nested
lines = 2;
columns = 3;
lines {
    columns { >> "#"; }
    >> "\n";
}
