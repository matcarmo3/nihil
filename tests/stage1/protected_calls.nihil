// protected calls (SPEC §25): ?f(args) gives T?; a runtime error anywhere inside gives _ and
// its text in ?! instead of ending the program
at(list = [0], i = 0) { : list[i]; }
half(n = 0) { : 100 / n; }
deep(n = 0) { n == 0 { : 10 / n; } : deep(n - 1) + 1; }
noisy(n = 0) { >> "start "; : 1 / n; }
read(p = "") { : @ p; }
xs = [1, 2, 3];

a? = ?at(xs, 1);
>> a; >> "\n";
b? = ?at(xs, 5);
>> b; >> " | " + ?! + "\n";
c? = ?half(0);
>> c; >> " | " + ?! + "\n";
d? = ?half(4);
>> d; >> " | [" + ?! + "]\n";                // a call that works leaves ?! empty
e? = ?deep(50);
>> e; >> " | " + ?! + "\n";                  // from 50 frames down
f? = ?noisy(0);
>> "| "; >> f; >> "\n";                      // "start " was written before the error and stays
h? = ?read("/no/such/file");
>> h; >> " | " + ?! + "\n";
k? = ?"planograma".slice(2, 6);              // a library call
>> k; >> "\n";

// in a loop the stack does not grow
failed = 0; worked = 0; i = 0;
* i < 100000 { r? = ?at(xs, i % 4); r == _ { failed = failed + 1; } || { worked = worked + 1; } i = i + 1; }
>> $failed + " failed, " + $worked + " worked\n";

// nested: the innermost protection catches; the outer call works
inner(i = 0) { r? = ?at(xs, i); r == _ { : -1; } : r || 0; }
outer(i = 0) { : inner(i) * 2; }
g? = ?outer(9);
>> g; >> " | [" + ?! + "]\n";

// a command (no value): the error is only in ?!
shout(n = 0) { >> $(10 / n) + "\n"; }
?shout(5);
?shout(0);
>> "after: " + ?! + "\n";
