// ARRAY + ARRAY of the same type: a new ARRAY, the left elements first
v = [1, 2] + [3];
>> #v; >> v[0]; >> v[2]; >> "\n";
w = v + v + [0 ; 0];
>> #w; >> " "; >> w.sum(); >> "\n";
s = ["a"] + ["b", "c"];
>> s.join("-"); >> "\n";
acc = ["" ; 0];
i = 0;
* i < 5 { acc = acc + [$i]; i = i + 1; }
>> acc.join(","); >> " "; >> v[0]; >> "\n";
P = @[n: INT(3)];
rows = [P(1)] + [P(2), P(3)];
>> rows[2].n; >> $(rows + rows); 
f = [1.5] + [2.5];
>> f.sum(); >> "\n";
big = [0 ; 0];
i = 0;
* i < 2000 { big = big + [i]; i = i + 1; }
>> #big; >> " "; >> big.sum(); >> "\n";
