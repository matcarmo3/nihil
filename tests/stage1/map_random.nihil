// 300 mil operações aleatórias (gravar, somar, apagar) conferidas contra um array
N = 20000;
ref = [0 ; N];          // 0 = ausente; senão valor + 1
m = {0: 0 ; 0};
x = 7;
k = 0;
* k < 300000 {
    x = (x * 1103515245 + 12345) % 2147483648;
    key = (x >> 4) % N;
    op = (x >> 20) % 4;
    op == 0 { m[key] = _; ref[key] = 0; }
    || { v = (m[key] || 0) + key % 13 + 1; m[key] = v; ref[key] = v + 1; }
    k = k + 1;
}
bad = 0;
n = 0;
i = 0;
* i < N {
    ref[i] == 0 { m[i] != _ { bad = bad + 1; } } || { n = n + 1; (m[i] || -1) != ref[i] - 1 { bad = bad + 1; } }
    i = i + 1;
}
>> "chaves " + $#m + " esperado " + $n + " erros " + $bad + "\n";
s = {"": 0 ; 0};
i = 0;
* i < 50000 { s["k" + $(i % 30000)] = i; i = i + 1; }
>> "texto " + $#s + " " + $(s["k29999"] || -1) + " " + $(s["k0"] || -1) + "\n";
