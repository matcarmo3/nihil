// the collector must keep everything still reachable: records in an ARRAY,
// their STRING fields, and arrays held only by locals, while garbage piles up
R = @[id: INT(8); name: STRING(40); tag: STRING(8)];
txt(n = 0) {
    td = [0 ; 20];
    tk = 0;
    * n > 0 || tk == 0 { td[19 - tk] = '0' + n % 10; n = n / 10; tk = tk + 1; }
    tb = [0 ; tk];
    ti = 0;
    tk { tb[ti] = td[20 - tk + ti]; ti = ti + 1; }
    : $tb;
}
label(j = 0, round = 0) {
    : "r" + txt(j * 7 + round) + "-" + txt(round % 13);
}
N = 3000;
rows = [R() ; N];
i = 0;
* i < N { rows[i] = R(i * 1000, label(i, 0), "t"); i = i + 1; }
x = 7;
round = 1;
* round <= 60 {
    k = 0;
    * k < 2000 {
        x = (x * 1103515245 + 12345) % 2147483648;
        j = (x >> 8) % N;
        rows[j] = R(j * 1000 + round, label(j, round), "t" + txt(round));
        junk = [k ; 50];                     // garbage
        k = k + 1;
    }
    round = round + 1;
}
// every record still has its own text: rebuild it from its id and compare
bad = 0;
i = 0;
* i < N {
    r = rows[i].id % 1000;
    rows[i].id / 1000 != i { bad = bad + 1; }
    rows[i].name != label(i, r) { bad = bad + 1; }
    r > 0 && rows[i].tag != "t" + txt(r) { bad = bad + 1; }
    i = i + 1;
}
>> "bad "; >> bad; >> "\n";
