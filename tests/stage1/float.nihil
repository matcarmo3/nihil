a = 0.1;
b = 0.2;
>> a + b; >> " "; >> a + b == 0.3; >> "\n";
>> 1.5 * 4.0; >> " "; >> 10.0 / 4.0; >> " "; >> -2.5; >> " "; >> 7.0 - 0.5; >> "\n";
// conversions: .n (INT → FLOAT) and #f (FLOAT → INT, truncating)
n = 7;
>> .n; >> " "; >> #3.99; >> " "; >> #(-3.99); >> " "; >> .(n * 2) / 4.0; >> "\n";
// formatting: the shortest decimal that reads back as the same number
>> 1.0 / 3.0; >> " "; >> 2.0 / 3.0; >> " "; >> 100.0; >> " "; >> 0.001; >> "\n";
>> 1.0e21; >> " "; >> 1.0e20; >> " "; >> 1.5e-10; >> " "; >> 0.000001; >> " "; >> 1.0e-7; >> "\n";
>> 1.7976931348623157e308; >> " "; >> 4.9406564584124654e-324; >> " "; >> 2.2250738585072014e-308; >> "\n";
// specials
zero = 0.0;
>> 1.0 / zero; >> " "; >> -1.0 / zero; >> " "; >> zero / zero; >> " "; >> -zero; >> "\n";
nan = zero / zero;
>> nan == nan; >> " "; >> nan != nan; >> " "; >> nan < 1.0; >> " "; >> 1.0 / zero > 1.0e308; >> "\n";
// comparisons
>> 1.5 < 2.5; >> 2.5 <= 2.5; >> 3.0 > 2.0; >> 2.0 >= 3.0; >> 0.5 + 0.25 == 0.75; >> 1.0 != 1.0; >> "\n";
