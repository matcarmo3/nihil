// the library: value.name(…) on STRING and ARRAY, and $ of INT, FLOAT and BOOL
s = "  Hello, World, Nihil  ";
>> "[" + s.trim() + "]\n";
>> s.find("World") || -1; >> " "; >> s.find("zzz") || -1; >> " "; >> s.has("Nihil"); >> "\n";
t = s.trim();
>> t.starts("Hello"); >> t.ends("Nihil"); >> t.ends("x"); >> "\n";
>> t.slice(7, 12) + "|" + t.slice(-5) + "|" + t.slice(100) + "|\n";
parts = t.split(", ");
>> #parts; >> " "; >> parts[1]; >> " "; >> parts.join("+"); >> "\n";
>> t.replace("l", "L") + " " + t.upper() + " " + t.lower() + "\n";
>> "ab".repeat(3) + "\n";
>> ("42".int() || 0) + 1; >> " "; >> " -17 ".int() || 0; >> " "; >> "4x".int() == _; >> " "; >> "".int() == _; >> "\n";
>> "3.25".float() || 0.0; >> " "; >> "abc".float() == _; >> "\n";
>> $42 + "/" + $(-7) + "/" + $true + "/" + $false + "/" + $2.5 + "\n";
v = [5, 3, 9, 1, 3, 7];
w = v.sort();
>> w[0]; >> w[1]; >> w[2]; >> w[5]; >> " "; >> v[0]; >> " "; >> v.find(9) || -1; >> v.has(4); >> " "; >> v.sum(); >> " "; >> v.min() || 0; >> v.max() || 0; >> "\n";
names = ["pear", "apple", "fig", "apple2", "banana"];
>> names.sort().join(","); >> " "; >> names.reverse()[0]; >> " "; >> names.find("fig") || -1; >> "\n";
f = [2.5, -1.0, 9.75];
>> f.sort()[0]; >> " "; >> f.sum(); >> " "; >> f.max() || 0.0; >> "\n";
e = [0 ; 0];
>> e.sort().sum(); >> " "; >> e.min() == _; >> "\n";
