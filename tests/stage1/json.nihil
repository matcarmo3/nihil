// JSON as text: s.json(key), json_items, json_keys, json_values, json_text, json_quote
t = "{\"nome\": \"Caf\\u00e9 \\\"forte\\\"\\n\", \"lista\": [1, 2.5, \"três\", {\"a\": [true, null]}], \"vazio\": {}, \"n\": -12, \"emoji\": \"\\ud83d\\ude00\"}";
>> (t.json("nome") || "").json_text() || "?";
lista = (t.json("lista") || "[]").json_items();
>> $#lista + " | " + lista[3] + " | " + $((lista[1].float() || 0.0) * 2.0) + " | " + (lista[2].json_text() || "") + "\n";
>> $((t.json("n") || "0").int() || 0) + " " + $(t.json("faltando") == _) + " " + $#(t.json("vazio") || "").json_keys() + " " + $#"[]".json_items() + "\n";
>> t.json_keys().join(",") + "\n";
v = t.json_values();
>> v[3] + " " + $((v[4].json_text() || "") == "😀") + " " + $#(v[4].json_text() || "") + "\n";
s = "{\"0\": {\"width\": 338, \"shelves\": {\"0\": {\"h\": 82.5}, \"1\": {\"h\": 40}}}, \"1\": {\"width\": 200}}";
total = 0.0;
w = s.json_values();
i = 0;
* i < #w { total = total + ((w[i].json("width") || "0").float() || 0.0); i = i + 1; }
>> $total + " " + $#((s.json("0") || "").json("shelves") || "").json_keys() + "\n";
>> "a \"b\"\n\tc\\".json_quote() + "\n";
>> $("not json".json("x") == _) + " " + $#"[1, 2".json_items() + " " + $("{\"a\": }".json("a") == _) + "\n";
