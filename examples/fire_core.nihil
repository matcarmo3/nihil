// =============================================================================
// The PSX Doom fire effect: the simulation, shared by doom_fire.nihil (terminal)
// and doom_fire_ppm.nihil (a still image).
//
// The fire is a grid of "heat" values from 0 to 36. The bottom row stays at 36.
// Every frame, each pixel moves up one row, cools a little and drifts sideways
// by up to one pixel at random. The palette maps heat to color.
// =============================================================================

FIRE_W = 80;                    // pixels (= terminal columns)
FIRE_H = 48;                    // pixels (= 2 × terminal lines)
fire = [0 ; FIRE_W * FIRE_H];

// heat → color 0xRRGGBB: black, dark red, red, orange, yellow, white
PALETTE = [
    0x070707, 0x1F0707, 0x2F0F07, 0x470F07, 0x571707, 0x671F07, 0x771F07, 0x8F2707,
    0x9F2F07, 0xAF3F07, 0xBF4707, 0xC74707, 0xDF4F07, 0xDF5707, 0xDF5707, 0xD75F07,
    0xD75F07, 0xD7670F, 0xCF6F0F, 0xCF770F, 0xCF7F0F, 0xCF8717, 0xC78717, 0xC78F17,
    0xC7971F, 0xBF9F1F, 0xBF9F1F, 0xBFA727, 0xBFA727, 0xBFAF2F, 0xB7AF2F, 0xB7B72F,
    0xB7B737, 0xCFCF6F, 0xDFDF9F, 0xEFEFC7, 0xFFFFFF
];
MAX_HEAT = 36;

// pseudo-random numbers: a 64-bit linear congruential generator (wraps around)
fire_seed = 20261120;
fire_random() {
    fire_seed = fire_seed * 6364136223846793005 + 1442695040888963407;
    : (fire_seed >> 33) & 0x7FFFFFFF;
}

// lights (heat 36) or puts out (heat 0) the bottom row
fire_source(heat = 0) {
    i = 0;
    FIRE_W { fire[(FIRE_H - 1) * FIRE_W + i] = heat; i = i + 1; }
}

// one frame of the simulation
fire_step() {
    x = 0;
    * x < FIRE_W {
        y = 1;
        * y < FIRE_H {
            src = y * FIRE_W + x;
            heat = fire[src];
            heat == 0 {
                fire[src - FIRE_W] = 0;
            } || {
                r = fire_random();
                drift = r & 3;
                // the original loses 0 or 1 per row (0.5 on average) on a
                // 168-row screen; with 48 rows it loses 0, 1 or 2 (1 on average)
                // so the flames reach about three quarters of the height
                cooled = heat - (r >> 2) % 3;
                cooled < 0 { cooled = 0; }
                dst = src - drift + 1 - FIRE_W; // up one row, drifting −1 … +2
                dst >= 0 && dst < FIRE_W * FIRE_H { fire[dst] = cooled; }
            }
            y = y + 1;
        }
        x = x + 1;
    }
}
