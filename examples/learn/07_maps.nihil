age = {"ana": 30, "bob": 25};
age["carla"] = 41;                      // adds or replaces
age["bob"] = _;                         // deletes
>> $#age + " people\n";
>> "ana is " + $(age["ana"] || 0) + "\n";
>> "dan is " + $(age["dan"] || 0) + "\n";   // m[k] is _ when the key is not there

// counting words
counts = {"": 0 ; 16};                  // an empty map of STRING to INT
words = "the cat and the hat and the bat".split(" ");
i = 0;
* i < #words {
    w = words[i];
    counts[w] = (counts[w] || 0) + 1;
    i = i + 1;
}
keys = counts.keys().sort();
i = 0;
* i < #keys { >> keys[i] + "=" + $(counts[keys[i]] || 0) + " "; i = i + 1; }
>> "\n";
