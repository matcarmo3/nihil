__nihil_s_space(c = 0) {
    : c == ' ' || c == 9 || c == 10 || c == 13;
}

// s.trim() → without spaces, tabs and line breaks at both ends
__nihil_s_trim(s = "") {
    __a = 0;
    * __a < #s && __nihil_s_space(s[__a]) { __a = __a + 1; }
    __b = #s;
    * __b > __a && __nihil_s_space(s[__b - 1]) { __b = __b - 1; }
    __a == 0 && __b == #s { : s; }
