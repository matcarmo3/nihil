// =============================================================================
// Prelude — routines written in Nihil that nihilc1 puts at the start of every
// program that uses FLOAT or `<<` (together with bigint.nihil and float_text.nihil).
// Programs that use neither do not get the prelude.
// Names starting with __nihil_ are reserved.
// =============================================================================

// >> and !>> of FLOAT: b = bits of the double; present = false prints "_"
__nihil_print_float(b = 0, present = true, error = false) {
    !present {
        error { !>> "_"; } || { >> "_"; }
        :;
    }
    __t = __nihil_ft_text(b);
    error { !>> __t; } || { >> __t; }
}

// a line of input, without the "\n" (or a "\r" before it); _ at the end of input
__nihil_read_line() {
    __c = 0;
    <<< __c;
    __c == -1 { : _; }
    __cap = 256;
    __buf = [0 ; __cap];
    __n = 0;
    * __c != 10 && __c != -1 {
        __n == __cap {
            __bigger = [0 ; __cap * 2];
            __i = 0;
            __cap { __bigger[__i] = __buf[__i]; __i = __i + 1; }
            __buf = __bigger;
            __cap = __cap * 2;
        }
        __buf[__n] = __c;
        __n = __n + 1;
        <<< __c;
    }
    __n > 0 && __buf[__n - 1] == 13 { __n = __n - 1; }
    __r = [0 ; __n];
    __i = 0;
    __n { __r[__i] = __buf[__i]; __i = __i + 1; }
    : $__r;
}

__nihil_input_invalid(type = "", s = "") {
    !>> "nihil: the input is not a valid ";
    !>> type;
    !>> ": '";
    !>> s;
    !>> "'\n";
    :: 2;
}

__nihil_read_str() {
    : __nihil_read_line();
}

__nihil_read_int() {
    __l? = __nihil_read_line();
    __l == _ { : _; }
    __s = __l || "";
    __i = 0;
    __neg = false;
    __i < #__s && (__s[__i] == '-' || __s[__i] == '+') {
        __neg = __s[__i] == '-';
        __i = __i + 1;
    }
    __i == #__s { __nihil_input_invalid("INT", __s); }
    __v = 0;
    * __i < #__s {
        __d = __s[__i] - '0';
        __d < 0 || __d > 9 { __nihil_input_invalid("INT", __s); }
        // up to 9223372036854775807 (or 9223372036854775808 with a minus sign)
        __v > 922337203685477580 || __v == 922337203685477580 && __d > 7 && !(__neg && __d == 8) {
            __nihil_input_invalid("INT", __s);
        }
        __v = __v * 10 + __d;
        __i = __i + 1;
    }
    __neg { __v = -__v; }
    : __v;
}

__nihil_read_bool() {
    __l? = __nihil_read_line();
    __l == _ { : _; }
    __s = __l || "";
    __s == "true" { : true; }
    __s == "false" { : false; }
    __nihil_input_invalid("BOOL", __s);
    : false;
}

// returns the bits of the FLOAT read (the compiler treats them as FLOAT?)
__nihil_read_float() {
    __l? = __nihil_read_line();
    __l == _ { : _; }
    __s = __l || "";
    __b = __nihil_ft_text_to_bits(__s);
    !__nihil_ft_valid { __nihil_input_invalid("FLOAT", __s); }
    : __b;
}

// ---- records (SPEC §20): fixed-width text, one record per line ----------------
// The compiler passes a record (or an ARRAY of records) as its address in an INT,
// with the model: schema = [n, type1, width1, …] (1 INT, 2 BOOL, 3 STRING,
// 7 FLOAT), the field names separated by spaces, and the model's name.
// __nihil_addr, __nihil_str_at and __nihil_arr_at are casts the compiler
// resolves without code: a record's slots are INTs, or STRING addresses.

__nihil_rec_width(schema = [0]) {
    __w = 0;
    __i = 0;
    schema[0] { __w = __w + schema[2 + __i * 2]; __i = __i + 1; }
    : __w;
}

// the n-th word of s (words separated by one space)
__nihil_word(s = "", n = 0) {
    __i = 0;
    __k = 0;
    * __k < n {
        s[__i] == ' ' { __k = __k + 1; }
        __i = __i + 1;
    }
    __j = __i;
    * __j < #s && s[__j] != ' ' { __j = __j + 1; }
    __b = [0 ; __j - __i];
    __m = 0;
    __j - __i { __b[__m] = s[__i + __m]; __m = __m + 1; }
    : $__b;
}

__nihil_int_text(v = 0) {
    v == 0 { : "0"; }
    v == -9223372036854775807 - 1 { : "-9223372036854775808"; }
    __x = v;
    __neg = __x < 0;
    __neg { __x = -__x; }
    __d = [0 ; 20];
    __k = 0;
    * __x > 0 {
        __d[19 - __k] = '0' + __x % 10;
        __x = __x / 10;
        __k = __k + 1;
    }
    __neg {
        __k = __k + 1;
        __d[20 - __k] = '-';
    }
    __r = [0 ; __k];
    __i = 0;
    __k { __r[__i] = __d[20 - __k + __i]; __i = __i + 1; }
    : $__r;
}

__nihil_type_name(t = 0) {
    t == 1 { : "INT"; }
    t == 2 { : "BOOL"; }
    t == 3 { : "STRING"; }
    : "FLOAT";
}

// a value that does not fit its field, when writing
__nihil_rec_bad(names = "", i = 0, model = "", what = "") {
    !>> "nihil: field '" + __nihil_word(names, i) + "' of " + model + " " + what + "\n";
    :: 2;
}

// a line of a table file that does not match the model, when reading
__nihil_table_bad(path = "", line = 0, what = "") {
    !>> "nihil: '" + path + "', line " + __nihil_int_text(line) + ": " + what + "\n";
    :: 2;
}

// writes the fields of record r into out, from position at: numbers aligned
// to the right, STRING to the left, BOOL as T or F; spaces fill the rest
__nihil_rec_put(r = 0, schema = [0], names = "", model = "", out = [0], at = 0) {
    __slots = __nihil_arr_at(r);
    __pos = at;
    __i = 0;
    * __i < schema[0] {
        __ty = schema[1 + __i * 2];
        __wd = schema[2 + __i * 2];
        __v = __slots[__i];
        __s = "";
        __left = false;
        __ty == 1 {
            __s = __nihil_int_text(__v);
        } || __ty == 2 {
            __s = "F";
            __v != 0 { __s = "T"; }
        } || __ty == 3 {
            __s = __nihil_str_at(__v);
            __left = true;
            __c = 0;
            #__s {
                __s[__c] == 10 { __nihil_rec_bad(names, __i, model, "cannot hold a line break"); }
                __c = __c + 1;
            }
        } || {
            __s = __nihil_ft_text(__v);
        }
        #__s > __wd {
            __kind = __nihil_type_name(__ty) + "(" + __nihil_int_text(__wd) + ")";
            __ty == 3 {
                __nihil_rec_bad(names, __i, model, "does not fit in " + __kind + ": the text has " + __nihil_int_text(#__s) + " bytes");
            }
            __nihil_rec_bad(names, __i, model, "does not fit in " + __kind + ": " + __s);
        }
        __j = 0;
        __wd { out[__pos + __j] = ' '; __j = __j + 1; }
        __start = __pos + __wd - #__s;
        __left { __start = __pos; }
        __j = 0;
        #__s { out[__start + __j] = __s[__j]; __j = __j + 1; }
        __pos = __pos + __wd;
        __i = __i + 1;
    }
}

// $r, @>> path, r : the record's line (with the "\n")
__nihil_rec_text(r = 0, schema = [0], names = "", model = "") {
    __w = __nihil_rec_width(schema);
    __out = [0 ; __w + 1];
    __nihil_rec_put(r, schema, names, model, __out, 0);
    __out[__w] = 10;
    : $__out;
}

// $rows, @>> path, rows : one line per record
__nihil_table_text(rows = [0], schema = [0], names = "", model = "") {
    __w = __nihil_rec_width(schema) + 1;
    __out = [0 ; #rows * __w];
    __i = 0;
    #rows {
        __nihil_rec_put(rows[__i], schema, names, model, __out, __i * __w);
        __out[__i * __w + __w - 1] = 10;
        __i = __i + 1;
    }
    : $__out;
}

// [r ; n] : n independent copies of record r
__nihil_rec_rep(r = 0, n = 0, schema = [0]) {
    __rows = [0 ; n];
    __src = __nihil_arr_at(r);
    __i = 0;
    n {
        __b = [0 ; schema[0]];
        __j = 0;
        schema[0] { __b[__j] = __src[__j]; __j = __j + 1; }
        __rows[__i] = __nihil_addr(__b);
        __i = __i + 1;
    }
    : __nihil_addr(__rows);
}

// INT field: spaces around, an optional sign, digits; empty is 0
__nihil_field_int(s = "", path = "", line = 0, names = "", i = 0) {
    #s == 0 { : 0; }
    __i = 0;
    __neg = false;
    s[0] == '-' || s[0] == '+' {
        __neg = s[0] == '-';
        __i = 1;
    }
    __ok = __i < #s;
    __v = 0;
    * __ok && __i < #s {
        __d = s[__i] - '0';
        __d < 0 || __d > 9 {
            __ok = false;
        } || __v > 922337203685477580 || __v == 922337203685477580 && __d > 7 && !(__neg && __d == 8) {
            __ok = false;
        } || {
            __v = __v * 10 + __d;
        }
        __i = __i + 1;
    }
    !__ok { __nihil_table_bad(path, line, "field '" + __nihil_word(names, i) + "' is not a valid INT: '" + s + "'"); }
    __neg { __v = -__v; }
    : __v;
}

// the record that starts at position at of the text (a line already checked)
__nihil_rec_parse(text = "", at = 0, schema = [0], names = "", path = "", line = 0) {
    __n = schema[0];
    __slots = [0 ; __n];
    __pos = at;
    __i = 0;
    * __i < __n {
        __ty = schema[1 + __i * 2];
        __wd = schema[2 + __i * 2];
        __a = __pos;
        __b = __pos + __wd;
        __ty != 3 { * __a < __b && text[__a] == ' ' { __a = __a + 1; } }    // STRING keeps leading spaces
        * __b > __a && text[__b - 1] == ' ' { __b = __b - 1; }
        __f = [0 ; __b - __a];
        __k = 0;
        __b - __a { __f[__k] = text[__a + __k]; __k = __k + 1; }
        __s = $__f;
        __ty == 1 {
            __slots[__i] = __nihil_field_int(__s, path, line, names, __i);
        } || __ty == 2 {
            __s == "T" {
                __slots[__i] = 1;
            } || __s != "F" && __s != "" {
                __nihil_table_bad(path, line, "field '" + __nihil_word(names, __i) + "' is not a BOOL (T or F): '" + __s + "'");
            }
        } || __ty == 3 {
            __slots[__i] = __nihil_addr(__s);
        } || #__s > 0 {
            __bits = __nihil_ft_text_to_bits(__s);
            !__nihil_ft_valid { __nihil_table_bad(path, line, "field '" + __nihil_word(names, __i) + "' is not a valid FLOAT: '" + __s + "'"); }
            __slots[__i] = __bits;
        }
        __pos = __pos + __wd;
        __i = __i + 1;
    }
    : __nihil_addr(__slots);
}

// NAME @ path : every line has exactly the model's width (the last one may
// lack its "\n"); returns the ARRAY of records
__nihil_table_read(path = "", text = "", schema = [0], names = "", model = "") {
    __w = __nihil_rec_width(schema);
    __len = #text;
    __n = 0;
    __pos = 0;
    * __pos < __len {
        __e = __pos;
        * __e < __len && text[__e] != 10 { __e = __e + 1; }
        __e - __pos != __w {
            __nihil_table_bad(path, __n + 1, "the line has " + __nihil_int_text(__e - __pos) + " bytes, but a " + model + " record has " + __nihil_int_text(__w));
        }
        __n = __n + 1;
        __pos = __e + 1;
    }
    __rows = [0 ; __n];
    __i = 0;
    __n {
        __rows[__i] = __nihil_rec_parse(text, __i * (__w + 1), schema, names, path, __i + 1);
        __i = __i + 1;
    }
    : __nihil_addr(__rows);
}

// NAME @# path : records in a file of `size` bytes (size < 0: no file → 0)
__nihil_rec_count(path = "", size = 0, schema = [0], model = "") {
    size < 0 { : 0; }
    __w = __nihil_rec_width(schema) + 1;
    __r = size % __w;
    __r != 0 && __r != __w - 1 {
        __nihil_table_bad(path, size / __w + 1, "the file ends in the middle of a " + model + " record (" + __nihil_int_text(size) + " bytes is not a whole number of " + __nihil_int_text(__w) + "-byte lines)");
    }
    __n = size / __w;
    __r != 0 { __n = __n + 1; }
    : __n;
}

// @[i]>> path, r : the line to write in place, after checking that i is a
// record of the file or the one just after the last (size: -1 = no file).
// If the last line lacks its "\n", writing after it puts the "\n" first.
__nihil_rec_place(i = 0, path = "", r = 0, size = 0, schema = [0], names = "", model = "") {
    __n = __nihil_rec_count(path, size, schema, model);
    i < 0 || i > __n {
        __last = "";
        __n > 0 { __last = ": 0 to " + __nihil_int_text(__n - 1) + ", or " + __nihil_int_text(__n) + " to add one"; }
        __n == 0 { __last = ": only 0, to add the first"; }
        !>> "nihil: '" + path + "' has no record " + __nihil_int_text(i) + " to write (it has " + __nihil_int_text(__n) + __last + ")\n";
        :: 2;
    }
    __text = __nihil_rec_text(r, schema, names, model);
    i == __n && size > 0 && size % (#__text) != 0 { : "\n" + __text; }
    : __text;
}

// NAME @[i] path : the line read at record i (chunk: STRING address, 0 = no
// file) → the record's address, or 0 (= _) for @?[i] when there is none
__nihil_rec_at(i = 0, path = "", chunk = 0, size = 0, schema = [0], names = "", model = "", opt = false) {
    chunk == 0 {
        opt { : 0; }
        !>> "nihil: could not read '" + path + "'\n";
        :: 2;
    }
    __n = __nihil_rec_count(path, size, schema, model);
    i < 0 || i >= __n {
        opt { : 0; }
        __last = "";
        __n > 0 { __last = ": 0 to " + __nihil_int_text(__n - 1); }
        !>> "nihil: '" + path + "' has no record " + __nihil_int_text(i) + " (it has " + __nihil_int_text(__n) + __last + ")\n";
        :: 2;
    }
    __text = __nihil_str_at(chunk);
    __w = __nihil_rec_width(schema);
    #__text < __w || #__text > __w && __text[__w] != 10 {
        __nihil_table_bad(path, i + 1, "the line does not have the width of a " + model + " record");
    }
    : __nihil_rec_parse(__text, 0, schema, names, path, i + 1);
}

// ---- the key index (§20.5): "<path>.nihil-idx" -------------------------------
// A hash table on disk: 16 bytes of header (the table's size and stamp when
// the index last matched it), then C slots of 4 bytes, little-endian, holding
// the record number + 1 (0 = empty). C is a power of two at least twice the
// number of records, so a search (linear probing) ends on an empty slot.
// The index is only a cache: when the header does not match the table, it is
// rebuilt from the table.

__nihil_key_hash(s = "") {
    __h = -3750763034362895579;               // FNV-1a, 64 bits
    __i = 0;
    #s { __h = (__h ^ s[__i]) * 1099511628211; __i = __i + 1; }
    : __h;
}

// n bytes of v, little-endian
__nihil_le(v = 0, n = 0) {
    __b = [0 ; n];
    __i = 0;
    n { __b[__i] = (v >> (__i * 8)) & 255; __i = __i + 1; }
    : $__b;
}

__nihil_le_put(b = [0], at = 0, v = 0, n = 0) {
    __i = 0;
    n { b[at + __i] = (v >> (__i * 8)) & 255; __i = __i + 1; }
}

__nihil_le_at(s = "", at = 0, n = 0) {
    __v = 0;
    __i = n;
    * __i > 0 {
        __i = __i - 1;
        __v = (__v << 8) | s[at + __i];
    }
    : __v;
}

// the key as text, from a value: an INT in decimal, a STRING without the
// spaces on its right (as a table file keeps it)
__nihil_key_value(v = 0, ty = 0) {
    ty == 1 { : __nihil_int_text(v); }
    __s = __nihil_str_at(v);
    __e = #__s;
    * __e > 0 && __s[__e - 1] == ' ' { __e = __e - 1; }
    __e == #__s { : __s; }
    __b = [0 ; __e];
    __i = 0;
    __e { __b[__i] = __s[__i]; __i = __i + 1; }
    : $__b;
}

// the key as text, from the line that starts at position at of text
__nihil_key_at(text = "", at = 0, schema = [0], names = "", path = "", line = 0, kf = 0) {
    __a = at;
    __i = 0;
    kf { __a = __a + schema[2 + __i * 2]; __i = __i + 1; }
    __ty = schema[1 + kf * 2];
    __b = __a + schema[2 + kf * 2];
    __ty == 1 { * __a < __b && text[__a] == ' ' { __a = __a + 1; } }
    * __b > __a && text[__b - 1] == ' ' { __b = __b - 1; }
    __f = [0 ; __b - __a];
    __k = 0;
    __b - __a { __f[__k] = text[__a + __k]; __k = __k + 1; }
    __ty == 1 { : __nihil_int_text(__nihil_field_int($__f, path, line, names, kf)); }
    : $__f;
}

__nihil_key_header(path = "") {
    : __nihil_le(__nihil_fsize(path), 8) + __nihil_le(__nihil_fstamp(path), 8);
}

// the capacity of the index if it matches the table (size and stamp), else 0
__nihil_key_current(idx = "", size = 0, stamp = 0) {
    __isz = __nihil_fsize(idx);
    __isz < 80 { : 0; }
    __c = (__isz - 16) / 4;
    __isz != 16 + __c * 4 || (__c & (__c - 1)) != 0 { : 0; }
    __p = __nihil_pread(idx, 0, 16);
    __p == 0 { : 0; }
    __h = __nihil_str_at(__p);
    #__h != 16 || __nihil_le_at(__h, 0, 8) != size || __nihil_le_at(__h, 8, 8) != stamp { : 0; }
    : __c;
}

// reads the whole table and writes a new index (atomically); → its capacity.
// Two records with the same key are an error.
__nihil_key_rebuild(path = "", size = 0, stamp = 0, schema = [0], names = "", model = "", kf = 0) {
    __n = __nihil_rec_count(path, size, schema, model);
    __c = 16;
    * __c < 2 * (__n + 1) { __c = __c * 2; }
    __w = __nihil_rec_width(schema) + 1;
    __text = "";
    size > 0 { __text = __nihil_str_at(__nihil_pread(path, 0, size)); }
    __slots = [0 ; __c];
    __i = 0;
    * __i < __n {
        __at = __i * __w;
        __at + __w <= #__text && __text[__at + __w - 1] != 10 {
            __nihil_table_bad(path, __i + 1, "the line does not have the width of a " + model + " record");
        }
        __k = __nihil_key_at(__text, __at, schema, names, path, __i + 1, kf);
        __j = __nihil_key_hash(__k) & (__c - 1);
        * __slots[__j] != 0 {
            __o = __slots[__j] - 1;
            __nihil_key_at(__text, __o * __w, schema, names, path, __o + 1, kf) == __k {
                __i == __n - 1 && __nihil_same_line(__text, __o * __w, __at, __w - 1) {
                    // a deletion that stopped after moving the last record into
                    // place: finish it, and index the table it leaves
                    __nihil_truncate(path, __at);
                    : __nihil_key_rebuild(path, __nihil_fsize(path), __nihil_fstamp(path), schema, names, model, kf);
                }
                __nihil_table_bad(path, __i + 1, "the key " + __nihil_word(names, kf) + " = " + __k + " is also in line " + __nihil_int_text(__o + 1) + ", and a key is unique");
            }
            __j = (__j + 1) & (__c - 1);
        }
        __slots[__j] = __i + 1;
        __i = __i + 1;
    }
    __b = [0 ; 16 + __c * 4];
    __nihil_le_put(__b, 0, size, 8);
    __nihil_le_put(__b, 8, stamp, 8);
    __i = 0;
    __c { __nihil_le_put(__b, 16 + __i * 4, __slots[__i], 4); __i = __i + 1; }
    @>> path + ".nihil-idx", $__b;
    : __c;
}

__nihil_same_line(s = "", a = 0, b = 0, n = 0) {
    __i = 0;
    * __i < n {
        s[a + __i] != s[b + __i] { : false; }
        __i = __i + 1;
    }
    : true;
}

// slot j of the index (0 = empty)
__nihil_key_slot(idx = "", j = 0) {
    __p = __nihil_pread(idx, 16 + j * 4, 4);
    __p == 0 { : 0; }
    __s = __nihil_str_at(__p);
    #__s != 4 { : 0; }
    : __nihil_le_at(__s, 0, 4);
}

// where the key is: [record number or -1, its slot (or the empty one where it
// would go), the capacity]. Every slot found is checked against the record.
__nihil_key_find(key = "", path = "", size = 0, stamp = 0, schema = [0], names = "", model = "", kf = 0) {
    __idx = path + ".nihil-idx";
    __c = __nihil_key_current(__idx, size, stamp);
    __c == 0 { __c = __nihil_key_rebuild(path, size, stamp, schema, names, model, kf); }
    __w = __nihil_rec_width(schema) + 1;
    __j = __nihil_key_hash(key) & (__c - 1);
    __left = __c;
    * __left > 0 {
        __v = __nihil_key_slot(__idx, __j);
        __v == 0 { : [-1, __j, __c]; }
        __o = __v - 1;
        __a = __nihil_pread(path, __o * __w, __w - 1);
        __a != 0 {
            __t = __nihil_str_at(__a);
            #__t == __w - 1 && __nihil_key_at(__t, 0, schema, names, path, __o + 1, kf) == key { : [__o, __j, __c]; }
        }
        __j = (__j + 1) & (__c - 1);
        __left = __left - 1;
    }
    : [-1, __j, __c];
}

// NAME @{k} path / NAME @?{k} path → the record's address, or 0 (= _)
__nihil_key_get(k = 0, path = "", schema = [0], names = "", model = "", kf = 0, opt = false) {
    __size = __nihil_fsize(path);
    __size < 0 {
        opt { : 0; }
        !>> "nihil: could not read '" + path + "'\n";
        :: 2;
    }
    __ty = schema[1 + kf * 2];
    __key = __nihil_key_value(k, __ty);
    __f = __nihil_key_find(__key, path, __size, __nihil_fstamp(path), schema, names, model, kf);
    __f[0] < 0 {
        opt { : 0; }
        __q = __key;
        __ty == 3 { __q = "\"" + __key + "\""; }
        !>> "nihil: '" + path + "' has no " + model + " with " + __nihil_word(names, kf) + " = " + __q + "\n";
        :: 2;
    }
    __w = __nihil_rec_width(schema);
    __t = __nihil_str_at(__nihil_pread(path, __f[0] * (__w + 1), __w));
    : __nihil_rec_parse(__t, 0, schema, names, path, __f[0] + 1);
}

// @{}>> path, r : replaces the record with r's key, or adds r at the end
__nihil_key_put(path = "", r = 0, schema = [0], names = "", model = "", kf = 0) {
    __text = __nihil_rec_text(r, schema, names, model);   // a value that does not fit stops here
    __key = __nihil_key_value(__nihil_arr_at(r)[kf], schema[1 + kf * 2]);
    __size = __nihil_fsize(path);
    __size < 0 { __size = 0; }
    __f = __nihil_key_find(__key, path, __size, __nihil_fstamp(path), schema, names, model, kf);
    __size = __nihil_fsize(path);                   // a rebuild may have finished a deletion
    __size < 0 { __size = 0; }
    __w = #__text;
    __idx = path + ".nihil-idx";
    __f[0] >= 0 {
        __nihil_pwrite(path, __f[0] * __w, __text);
    } || {
        __n = __nihil_rec_count(path, __size, schema, model);
        __at = __n * __w;
        __size % __w != 0 {                         // the last line lacks its "\n"
            __text = "\n" + __text;
            __at = __at - 1;
        }
        __nihil_pwrite(path, __at, __text);
        (__n + 1) * 2 > __f[2] {                    // over half full: a bigger index
            __nihil_key_rebuild(path, __nihil_fsize(path), __nihil_fstamp(path), schema, names, model, kf);
            :;
        }
        __nihil_pwrite(__idx, 16 + __f[1] * 4, __nihil_le(__n + 1, 4));
    }
    __nihil_pwrite_ns(__idx, 0, __nihil_key_header(path));   // if lost: rebuilt
}

// @[i]>> path, r for a model with a key: the index stays right when the key
// of line i does not change, and is marked old (rebuilt later) when it does
__nihil_key_write_at(i = 0, path = "", r = 0, schema = [0], names = "", model = "", kf = 0) {
    __size = __nihil_fsize(path);
    __stamp = __nihil_fstamp(path);
    __text = __nihil_rec_place(i, path, r, __size, schema, names, model);
    __w = __nihil_rec_width(schema) + 1;
    __idx = path + ".nihil-idx";
    __c = __nihil_key_current(__idx, __size, __stamp);
    __same = false;
    __c > 0 && i < __nihil_rec_count(path, __size, schema, model) {
        __p = __nihil_pread(path, i * __w, __w - 1);
        __p != 0 {
            __old = __nihil_str_at(__p);
            __same = #__old == __w - 1 && __nihil_key_at(__old, 0, schema, names, path, i + 1, kf) == __nihil_key_value(__nihil_arr_at(r)[kf], schema[1 + kf * 2]);
        }
    }
    __nihil_pwrite(path, (i + 1) * __w - #__text, __text);
    __same {
        __nihil_pwrite_ns(__idx, 0, __nihil_key_header(path));
    } || __c > 0 {
        __nihil_pwrite(__idx, 0, __nihil_le(-1, 16));
    }
}

// NAME @{k} path = _; : the last record moves into the place of the deleted
// one and the file loses its last line. Two fsyncs: the table first (the
// moved record, or the cut when the deleted record is the last one), then the
// index slots, before its header. The cut after a move is not synced: if it is
// lost, the last record is there twice, which the rebuild recognizes and
// finishes. A crash before the index is right leaves an index that does not
// match the table, which is rebuilt.
__nihil_key_delete(k = 0, path = "", schema = [0], names = "", model = "", kf = 0, opt = false) {
    __size = __nihil_fsize(path);
    __size < 0 {
        opt { :; }
        !>> "nihil: could not read '" + path + "'\n";
        :: 2;
    }
    __ty = schema[1 + kf * 2];
    __key = __nihil_key_value(k, __ty);
    __f = __nihil_key_find(__key, path, __size, __nihil_fstamp(path), schema, names, model, kf);
    __f[0] < 0 {
        opt { :; }
        __q = __key;
        __ty == 3 { __q = "\"" + __key + "\""; }
        !>> "nihil: '" + path + "' has no " + model + " with " + __nihil_word(names, kf) + " = " + __q + " to delete\n";
        :: 2;
    }
    __size = __nihil_fsize(path);                   // a rebuild may have finished a deletion
    __n = __nihil_rec_count(path, __size, schema, model);
    __w = __nihil_rec_width(schema) + 1;
    __i = __f[0];
    __mask = __f[2] - 1;
    __idx = path + ".nihil-idx";
    __last = __n - 1;
    __moved = "";
    __i != __last {
        __line = __nihil_str_at(__nihil_pread(path, __last * __w, __w - 1));
        __moved = __nihil_key_at(__line, 0, schema, names, path, __last + 1, kf);
        __nihil_pwrite(path, __i * __w, __line + "\n");   // synced before the cut
        __nihil_truncate_ns(path, __last * __w);
    } || {
        __nihil_truncate(path, __last * __w);
    }
    // the index: the moved record's slot now points to its new place …
    __i != __last {
        __j = __nihil_key_hash(__moved) & __mask;
        __left = __mask + 1;
        * __left > 0 && __nihil_key_slot(__idx, __j) != __last + 1 {
            __j = (__j + 1) & __mask;
            __left = __left - 1;
        }
        __left == 0 {                               // not found: the index is wrong
            __nihil_pwrite(__idx, 0, __nihil_le(-1, 16));
            :;
        }
        __nihil_pwrite_ns(__idx, 16 + __j * 4, __nihil_le(__i + 1, 4));
    }
    // … and the deleted key's slot is emptied, moving back each slot after it
    // whose home is not between the hole and itself (linear probing)
    __j = __f[1];
    __k = (__j + 1) & __mask;
    __v = __nihil_key_slot(__idx, __k);
    * __v != 0 {
        __r = __v - 1;
        __t = __nihil_str_at(__nihil_pread(path, __r * __w, __w - 1));
        __h = __nihil_key_hash(__nihil_key_at(__t, 0, schema, names, path, __r + 1, kf)) & __mask;
        __stay = false;
        __j < __k {
            __stay = __h > __j && __h <= __k;
        } || {
            __stay = __h > __j || __h <= __k;
        }
        !__stay {
            __nihil_pwrite_ns(__idx, 16 + __j * 4, __nihil_le(__v, 4));
            __j = __k;
        }
        __k = (__k + 1) & __mask;
        __v = __nihil_key_slot(__idx, __k);
    }
    __nihil_pwrite(__idx, 16 + __j * 4, __nihil_le(0, 4));   // synced: every slot is on the disk
    __nihil_pwrite_ns(__idx, 0, __nihil_key_header(path));
}
