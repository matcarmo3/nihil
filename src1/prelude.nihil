        __i = __i + 1;
    }
    : __r;
}

__nihil_s_upper(s = "") {
    : __nihil_s_case(s, 'a', 'z', 'A' - 'a');
}

__nihil_s_lower(s = "") {
    : __nihil_s_case(s, 'A', 'Z', 'a' - 'A');
}

