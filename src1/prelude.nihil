// NAME @{k} path = _; : the last record moves into the place of the deleted
// one and the file loses its last line. Two fsyncs: the table first (the
// moved record, or the cut when the deleted record is the last one), then the
// index slots, before its header. The cut after a move is not synced: if it is
// lost, the last record is there twice, which the rebuild recognizes and
// finishes. A crash before the index is right leaves an index that does not
// match the table, which is rebuilt.
__nihil_key_delete(k = 0, path = "", schema = [0], names = "", model = "", kf = 0, opt = false) {
    __size = __nihil_fsize(path);
    __size < 0 {
        opt { :; }
        !>> "nihil: could not read '" + path + "'\n";
        :: 2;
    }
    __ty = schema[1 + kf * 2];
    __key = __nihil_key_value(k, __ty);
    __f = __nihil_key_find(__key, path, __size, __nihil_fstamp(path), schema, names, model, kf);
    __f[0] < 0 {
        opt { :; }
        __q = __key;
        __ty == 3 { __q = "\"" + __key + "\""; }
        !>> "nihil: '" + path + "' has no " + model + " with " + __nihil_word(names, kf) + " = " + __q + " to delete\n";
        :: 2;
    }
    __size = __nihil_fsize(path);                   // a rebuild may have finished a deletion
    __n = __nihil_rec_count(path, __size, schema, model);
    __w = __nihil_rec_width(schema) + 1;
    __i = __f[0];
    __mask = __f[2] - 1;
    __idx = path + ".nihil-idx";
    __last = __n - 1;
    __moved = "";
    __i != __last {
        __line = __nihil_str_at(__nihil_pread(path, __last * __w, __w - 1));
        __moved = __nihil_key_at(__line, 0, schema, names, path, __last + 1, kf);
        __nihil_pwrite(path, __i * __w, __line + "\n");   // synced before the cut
        __nihil_truncate_ns(path, __last * __w);
    } || {
        __nihil_truncate(path, __last * __w);
    }
    // the index: the moved record's slot now points to its new place …
    __i != __last {
        __j = __nihil_key_hash(__moved) & __mask;
        __left = __mask + 1;
        * __left > 0 && __nihil_key_slot(__idx, __j) != __last + 1 {
            __j = (__j + 1) & __mask;
            __left = __left - 1;
        }
        __left == 0 {                               // not found: the index is wrong
            __nihil_pwrite(__idx, 0, __nihil_le(-1, 16));
            :;
        }
        __nihil_pwrite_ns(__idx, 16 + __j * 4, __nihil_le(__i + 1, 4));
    }
    // … and the deleted key's slot is emptied, moving back each slot after it
    // whose home is not between the hole and itself (linear probing)
    __j = __f[1];
    __k = (__j + 1) & __mask;
    __v = __nihil_key_slot(__idx, __k);
    * __v != 0 {
        __r = __v - 1;
        __t = __nihil_str_at(__nihil_pread(path, __r * __w, __w - 1));
        __h = __nihil_key_hash(__nihil_key_at(__t, 0, schema, names, path, __r + 1, kf)) & __mask;
        __stay = false;
        __j < __k {
            __stay = __h > __j && __h <= __k;
        } || {
            __stay = __h > __j || __h <= __k;
        }
        !__stay {
            __nihil_pwrite_ns(__idx, 16 + __j * 4, __nihil_le(__v, 4));
            __j = __k;
        }
        __k = (__k + 1) & __mask;
        __v = __nihil_key_slot(__idx, __k);
    }
    __nihil_pwrite(__idx, 16 + __j * 4, __nihil_le(0, 4));   // synced: every slot is on the disk
    __nihil_pwrite_ns(__idx, 0, __nihil_key_header(path));
}

// ---- the library (SPEC §21): value.name(…) -------------------------------------
// The compiler passes the value as the first argument. Results are new values:
// nothing changes the STRING or the ARRAY it is called on.

// does t appear in s at position at?
__nihil_s_match(s = "", at = 0, t = "") {
    __i = 0;
    * __i < #t {
        s[at + __i] != t[__i] { : false; }
        __i = __i + 1;
    }
    : true;
}

// s.find(t) / s.find(t, from) → INT?: where t first appears, or _
__nihil_s_find(s = "", t = "", from = 0) {
    __i = from;
    __i < 0 { __i = 0; }
    * __i + #t <= #s {
        __nihil_s_match(s, __i, t) { : __i; }
        __i = __i + 1;
    }
    : _;
}

__nihil_s_has(s = "", t = "") {
    __p? = __nihil_s_find(s, t, 0);
    : !(__p == _);
}

__nihil_s_starts(s = "", t = "") {
    : #t <= #s && __nihil_s_match(s, 0, t);
}

__nihil_s_ends(s = "", t = "") {
    : #t <= #s && __nihil_s_match(s, #s - #t, t);
