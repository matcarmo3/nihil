// =============================================================================
// 48_library — value.name(…): the library (SPEC §21). The methods are written
// in Nihil in the prelude, as __nihil_s_* (STRING), __nihil_ai_* (ARRAY of
// INT), __nihil_af_* (FLOAT) and __nihil_as_* (STRING); the value goes as the
// first argument. The names exist only after a ".", so they take no name away
// from the program.
// =============================================================================

// the constant "true" or "false" (for $b)
bool_text(b = false) {
    const_init();
    b { const_put_str("true"); } || { const_put_str("false"); }
    : const_close();
}

// tok = "." : is it ". name (" (a library call) rather than a field?
library_ahead() {
    save_lexer();
    next_token();
    r = tok_type == T_IDENT;
    r {
        next_token();
        r = tok_type == '(';
    }
    back_lexer();
    drop_lexer();
    : r;
}

// the prelude method for value type t and the name at s (n bytes); "" if none
lib_target(t = 0, s = 0, n = 0) {
    t == TYPE_STR {
        name_is(s, n, "find") { : "__nihil_s_find"; }
        name_is(s, n, "has") { : "__nihil_s_has"; }
        name_is(s, n, "starts") { : "__nihil_s_starts"; }
        name_is(s, n, "ends") { : "__nihil_s_ends"; }
        name_is(s, n, "slice") { : "__nihil_s_slice"; }
        name_is(s, n, "split") { : "__nihil_s_split"; }
        name_is(s, n, "replace") { : "__nihil_s_replace"; }
        name_is(s, n, "trim") { : "__nihil_s_trim"; }
        name_is(s, n, "upper") { : "__nihil_s_upper"; }
        name_is(s, n, "lower") { : "__nihil_s_lower"; }
        name_is(s, n, "repeat") { : "__nihil_s_repeat"; }
        name_is(s, n, "int") { : "__nihil_s_int"; }
        name_is(s, n, "float") { : "__nihil_s_float"; }
        name_is(s, n, "json") { : "__nihil_s_json"; }
        name_is(s, n, "json_items") { : "__nihil_s_json_items"; }
        name_is(s, n, "json_keys") { : "__nihil_s_json_keys"; }
        name_is(s, n, "json_values") { : "__nihil_s_json_values"; }
        name_is(s, n, "json_text") { : "__nihil_s_json_text"; }
        name_is(s, n, "json_quote") { : "__nihil_s_json_quote"; }
        : "";
    }
    t == TYPE_ARR | TYPE_INT {
        name_is(s, n, "sort") { : "__nihil_ai_sort"; }
        name_is(s, n, "find") { : "__nihil_ai_find"; }
        name_is(s, n, "has") { : "__nihil_ai_has"; }
        name_is(s, n, "reverse") { : "__nihil_ai_reverse"; }
        name_is(s, n, "sum") { : "__nihil_ai_sum"; }
        name_is(s, n, "min") { : "__nihil_ai_min"; }
        name_is(s, n, "max") { : "__nihil_ai_max"; }
        : "";
    }
    t == TYPE_ARR | TYPE_FLOAT {
        name_is(s, n, "sort") { : "__nihil_af_sort"; }
        name_is(s, n, "find") { : "__nihil_af_find"; }
        name_is(s, n, "has") { : "__nihil_af_has"; }
        name_is(s, n, "reverse") { : "__nihil_af_reverse"; }
        name_is(s, n, "sum") { : "__nihil_af_sum"; }
        name_is(s, n, "min") { : "__nihil_af_min"; }
        name_is(s, n, "max") { : "__nihil_af_max"; }
        : "";
    }
    t == TYPE_ARR | TYPE_STR {
        name_is(s, n, "sort") { : "__nihil_as_sort"; }
        name_is(s, n, "find") { : "__nihil_as_find"; }
        name_is(s, n, "has") { : "__nihil_as_has"; }
        name_is(s, n, "reverse") { : "__nihil_as_reverse"; }
        name_is(s, n, "join") { : "__nihil_as_join"; }
        : "";
    }
    : "";
}

lib_missing(t = 0, s = 0, n = 0) {
    error_start();
    put_type(t);
    t == TYPE_STR {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has find, has, starts, ends, slice, split, replace, trim, upper, lower, repeat, int, float, json, json_items, json_keys, json_values, json_text and json_quote");
        error_end();
    }
    t == TYPE_ARR | TYPE_INT || t == TYPE_ARR | TYPE_FLOAT {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has sort, find, has, reverse, sum, min and max");
        error_end();
    }
    t == TYPE_ARR | TYPE_STR {
        put_str(" has no method '");
        put_source(s, n);
        put_str("': it has sort, find, has, reverse and join");
        error_end();
    }
    put_str(" has no methods (the library works on STRING and on ARRAY of INT, FLOAT or STRING)");
    error_end();
}

// tok = "." of value.name(…), with the value (type t) in rax → the result's type
library_call(t = 0) {
    next_token();                        // "." → name
    ns = tok_start; nl = tok_len;
    t == TYPE_UNKNOWN {
        // the value has no type yet: skip the arguments (they may use field
        // names) and decide in the next pass
        sc = size_const;
        next_token();                    // name → "("
        depth = 0;
        going = true;
        * going {
            tok_type == T_END { error_expected("')'"); }
            tok_type == '(' || tok_type == '[' || tok_type == '{' { depth = depth + 1; }
            tok_type == ')' || tok_type == ']' || tok_type == '}' {
                depth = depth - 1;
                depth == 0 { going = false; }
            }
            next_token();
        }
        size_const = sc;
        unknowns = unknowns + 1;
        : TYPE_UNKNOWN;
    }
    is_rec_array(t) { : query_call(t); }
    is_map(t) { : map_method(t, ns, nl); }
    target = lib_target(t, ns, nl);
    #target == 0 { lib_missing(t, ns, nl); }
    k = lookup_text(target);
    k < 0 || s_flags[k] & FLAG_METHOD == 0 { error_general("internal error: the library was not included"); }
    emit(0x50);                            // push rax: the value is the first argument
    sv_k = lib_k; sv_s = lib_name_start; sv_l = lib_name_len;
    lib_k = k; lib_name_start = ns; lib_name_len = nl;
    r = call_method(k, 1);
    lib_k = sv_k; lib_name_start = sv_s; lib_name_len = sv_l;
    t == TYPE_STR && name_is(ns, nl, "float") { r = TYPE_FLOAT | TYPE_OPT; }   // the prelude gives the bits
    : r;
}

// ---- queries on an ARRAY of records (SPEC §21.1) ---------------------------------
// rows.where(cond), rows.count(cond), rows.first(cond), rows.sort(key),
// rows.sum(expr): the argument is compiled once, inside a loop over the
// elements, with the model's field names standing for the fields of the
// current element. It can use any other name of the program, locals included.

// hidden locals of the loop: [rbp + d] with d from new_slot()
q_load(r = 0, d = 0) {                  // mov rax|rcx|rdx, [rbp + d]  (r: 0, 1, 2)
    r == 0 { eb(0x48, 0x8B, 0x85); }
    r == 1 { eb(0x48, 0x8B, 0x8D); }
    r == 2 { eb(0x48, 0x8B, 0x95); }
    emit_d(d);
}

q_store(d = 0) {                        // mov [rbp + d], rax
    eb(0x48, 0x89, 0x85);
    emit_d(d);
}

q_zero(d = 0) {                         // mov qword [rbp + d], 0
    eb(0x48, 0xC7, 0x85);
    emit_d(d);
    emit_d(0);
}

q_inc(d = 0) {                          // inc qword [rbp + d]
    eb(0x48, 0xFF, 0x85);
    emit_d(d);
}

// inside a query: a field name of the current element → its value
query_field() {
    q_model < 0 || peek_type() == '(' { : -1; }
    j = find_field(q_model, tok_start, tok_len);
    j < 0 { : -1; }
    q_load(0, q_elem);
    eb(0x48, 0x8B, 0x80);                   // mov rax, [rax + disp32]
    emit_d(j * 8);
    next_token();
    : f_type[m_first[q_model] + j];
}

query_missing(t = 0, s = 0, n = 0) {
    error_start();
    put_type(t);
    put_str(" has no method '");
    put_source(s, n);
    put_str("': it has where, count, first, sort and sum, with an expression of the fields (rows.where(price > 10.0))");
    error_end();
}

// tok = name of rows.name(…), the ARRAY (type t) in rax → the result's type
query_call(t = 0) {
    ns = tok_start; nl = tok_len;
    kind = 0;
    name_is(ns, nl, "where") { kind = 1; }
    name_is(ns, nl, "count") { kind = 2; }
    name_is(ns, nl, "first") { kind = 3; }
    name_is(ns, nl, "sort") { kind = 4; }
    name_is(ns, nl, "sum") { kind = 5; }
    kind == 0 { query_missing(t, ns, nl); }
    m = (t & ~TYPE_ARR) >> 8;
    next_token();                        // name → "("
    next_token();
    tok_type == ')' {
        error_start();
        put_str("'.");
        put_source(ns, nl);
        put_str("' needs an expression of the fields of ");
        put_type(model_type(m));
        put_str(", like rows.");
        put_source(ns, nl);
        kind == 4 || kind == 5 { put_str("(price)"); } || { put_str("(price > 10.0)"); }
        error_end();
    }
    sv_slots = slots;
    d_arr = new_slot();
    d_i = new_slot();
    d_res = new_slot();
    d_n = new_slot();
    d_el = new_slot();
    q_store(d_arr);
    q_zero(d_i);
    q_zero(d_n);
    q_zero(d_res);
    kind == 1 || kind == 4 {
        eb(0x48, 0x8B, 0x48, 0xF8);         // mov rcx, [rax - 8]
        emit_call_rt(RT_ALLOC);            // the result (where) or the keys (sort)
        q_store(d_res);
    }
    top = size_code;
    last_target = size_code;               // the loop comes back here
    q_load(0, d_i);
    q_load(1, d_arr);
    eb(0x48, 0x3B, 0x41, 0xF8);             // cmp rax, [rcx - 8]
    eb(0x0F, 0x8D);                         // jge end
    p_end = size_code;
    emit_d(0);
    eb(0x48, 0x8B, 0x04, 0xC1);             // mov rax, [rcx + rax*8]
    q_store(d_el);
    sv_m = q_model; sv_e = q_elem;
    q_model = m; q_elem = d_el;
    pi = tok_start; pl = tok_len; pn = tok_line; pli = tok_lstart;
    u = expression();
    q_model = sv_m; q_elem = sv_e;
    p_next = -1;
    p_break = -1;
    kind <= 3 {
        u != TYPE_BOOL && u != TYPE_UNKNOWN { query_type(ns, nl, u, "a BOOL condition", pi, pl, pn, pli); }
        eb(0x48, 0x85, 0xC0, 0x0F, 0x84);   // test rax, rax ; jz next
        p_next = size_code;
        emit_d(0);
        kind == 1 {
            q_load(1, d_res);
            q_load(2, d_n);
            q_load(0, d_el);
            eb(0x48, 0x89, 0x04, 0xD1);     // mov [rcx + rdx*8], rax
            q_inc(d_n);
        }
        kind == 2 { q_inc(d_n); }
        kind == 3 {
            q_load(0, d_el);
            q_store(d_res);
            q_inc(d_n);
            emit(0xE9);                    // jmp end: the first one is enough
            p_break = size_code;
            emit_d(0);
        }
    }
    kind == 4 {
        u != TYPE_INT && u != TYPE_FLOAT && u != TYPE_STR && u != TYPE_UNKNOWN {
            query_type(ns, nl, u, "an INT, FLOAT or STRING key", pi, pl, pn, pli);
        }
        q_load(1, d_res);
        q_load(2, d_i);
        eb(0x48, 0x89, 0x04, 0xD1);         // mov [rcx + rdx*8], rax (the key)
    }
    kind == 5 {
        u != TYPE_INT && u != TYPE_FLOAT && u != TYPE_UNKNOWN { query_type(ns, nl, u, "an INT or FLOAT", pi, pl, pn, pli); }
        u == TYPE_FLOAT {
            eb(0xF3, 0x0F, 0x7E, 0x85);     // movq xmm0, [rbp + d_n]
            emit_d(d_n);
            eb(0x66, 0x48, 0x0F, 0x6E, 0xC8);   // movq xmm1, rax
            eb(0xF2, 0x0F, 0x58, 0xC1);     // addsd xmm0, xmm1
            eb(0x66, 0x0F, 0xD6, 0x85);     // movq [rbp + d_n], xmm0
            emit_d(d_n);
        } || {
            eb(0x48, 0x01, 0x85);           // add [rbp + d_n], rax
            emit_d(d_n);
        }
    }
    p_next >= 0 { patch_here(p_next); }
    q_inc(d_i);
    emit_jmp_to(top);
    patch_here(p_end);
    p_break >= 0 { patch_here(p_break); }
    expect(')', "')' (one expression of the fields)");
    r = t;
    kind == 1 {
        q_load(0, d_res);
        q_load(1, d_n);
        eb(0x48, 0x89, 0x48, 0xF8);         // mov [rax - 8], rcx: the elements that passed
    }
    kind == 2 { q_load(0, d_n); r = TYPE_INT; }
    kind == 3 {
        q_load(0, d_res);
        q_load(2, d_n);                    // presence: 1 if one was found
        r = model_type(m) | TYPE_OPT;
    }
    kind == 4 {
        q_load(0, d_arr);
        emit(0x50);
        q_load(0, d_res);
        emit(0x50);
        emit(0xB8);                        // mov eax, kind of key ; push rax
        u == TYPE_UNKNOWN { emit_d(1); } || { emit_d(u); }
        emit(0x50);
        call_prelude("__nihil_sort_by", 24);
    }
    kind == 5 {
        q_load(0, d_n);
        r = TYPE_INT;
        u == TYPE_FLOAT { r = TYPE_FLOAT; }
        u == TYPE_UNKNOWN { r = TYPE_UNKNOWN; }
    }
    slots = sv_slots;
    : r;
}

query_type(ns = 0, nl = 0, u = 0, what = "", pi = 0, pl = 0, pn = 0, pli = 0) {
    restore_pos(pi, pl, pn, pli);
    error_start();
    put_str("'.");
    put_source(ns, nl);
    put_str("' needs ");
    put_str(what);
    put_str(", but the expression is ");
    put_type(u);
    error_end();
}
