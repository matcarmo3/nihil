#!/bin/sh
# nihil — the command line of the Nihil compiler (https://nihil-lang.dev)
#
#   nihil PROGRAM.nihil [OUT]        compile into a native executable (OUT: PROGRAM without .nihil)
#   nihil run PROGRAM.nihil [ARG…]   compile into a temporary file and run it
#   nihil ide [--no-window]          the IDE, in an app window (workspace: ~/Nihil)
#   nihil version                    the version installed
#
#   NIHIL_O0=1   no optimizations
#
# The same script for every platform: on Linux x86_64 the compiler writes the executable itself;
# on macOS (Apple silicon) its x86-64 code is translated to ARM64 and linked by clang with the
# runtime (docs/macos-arm64.md), which needs the Xcode Command Line Tools (clang, objdump, python3).
set -eu

# where this installation is: bin/nihil, resolving the symbolic link that put it on the PATH
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
home=$(cd "$(dirname "$self")/.." && pwd -P)
lib=$home/libexec/nihil

usage() {
    echo "usage: nihil PROGRAM.nihil [OUT] | nihil run PROGRAM.nihil [ARG…] | nihil ide | nihil version" >&2
    exit 2
}

# opens URL in an app window (a browser with --app: no tabs, no address bar), or in the default browser
open_window() {
    url=$1
    if [ "$(uname -s)" = Darwin ]; then
        # installed as an app from Chrome/Edge/Brave (menu: Install page as app): its own window and icon
        for pwa in "$HOME/Applications/Chrome Apps.localized/Nihil IDE.app" "$HOME/Applications/Edge Apps.localized/Nihil IDE.app" "$HOME/Applications/Brave Browser Apps.localized/Nihil IDE.app"; do
            if [ -d "$pwa" ]; then
                open "$pwa"
                return
            fi
        done
        for app in "Google Chrome" "Microsoft Edge" "Brave Browser" "Chromium"; do
            if [ -d "/Applications/$app.app" ] || [ -d "$HOME/Applications/$app.app" ]; then
                open -na "$app" --args --app="$url" --new-window
                return
            fi
        done
        open "$url"
        return
    fi
    if [ -z "${DISPLAY:-}" ] && [ -z "${WAYLAND_DISPLAY:-}" ]; then
        echo "No display: open $url in a browser (through an SSH tunnel from another machine)"
        return
    fi
    for b in google-chrome google-chrome-stable chromium chromium-browser microsoft-edge brave-browser; do
        if command -v "$b" >/dev/null 2>&1; then
            "$b" --app="$url" --new-window >/dev/null 2>&1 &
            return
        fi
    done
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" >/dev/null 2>&1 &
    else
        echo "Open $url in a browser"
    fi
}

# the IDE: its server (in Nihil) in the foreground, the window opened once it answers
ide() {
    server=$lib/ide-server
    [ -x "$server" ] || { echo "nihil: this installation has no IDE" >&2; exit 1; }
    window=true
    [ "${1:-}" = "--no-window" ] && window=false
    ws=${NIHIL_WORKSPACE:-$HOME/Nihil}
    port=${NIHIL_IDE_PORT:-8730}
    url=http://127.0.0.1:$port/
    mkdir -p "$ws"
    # the examples are copied once, so they are the user's to change
    [ -e "$ws/examples" ] || cp -R "$home/share/nihil/examples" "$ws/examples"
    if curl -fs -o /dev/null "$url" 2>/dev/null; then
        echo "The IDE is already running: $url"
        "$window" && open_window "$url"
        exit 0
    fi
    if "$window"; then
        (
            i=0
            while [ $i -lt 50 ]; do
                if curl -fs -o /dev/null "$url" 2>/dev/null; then open_window "$url"; exit 0; fi
                sleep 0.2
                i=$((i + 1))
            done
        ) &
    fi
    echo "Nihil IDE: $url   (workspace: $ws; Ctrl+C stops it)"
    cd "$ws"
    NIHIL_IDE_INSTALL=$home NIHIL_IDE_ROOT=$ws NIHIL_IDE_PORT=$port exec "$server"
}

# compile SRC into OUT
compile() {
    src=$1
    out=$2
    [ -f "$src" ] && [ -r "$src" ] || { echo "nihil: could not open $src" >&2; exit 1; }
    option=""
    [ "${NIHIL_O0:-0}" = 1 ] && option="-O0 "
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT
    if [ -x "$lib/nihilc1-native" ]; then
        # macOS: the compiler emits x86-64 code and a map; translate.py makes ARM64 assembly of it
        if ! printf '%s\n' "$option-map $src" | "$lib/nihilc1-native" > "$work/p.x86" 2> "$work/p.map"; then
            grep -v '^nihil-map' "$work/p.map" >&2 || true
            exit 1
        fi
        grep -v '^nihil-map' "$work/p.map" >&2 || true
        python3 "$lib/translate.py" "$work/p.x86" "$work/p.map" "$work/p.s" 2> "$work/t.err" || { cat "$work/t.err" >&2; exit 1; }
        clang -arch arm64 -o "$out" "$work/p.s" "$lib/rt.o"
    else
        # Linux x86_64: the compiler writes the ELF executable to its standard output
        printf '%s\n' "$option$src" | "$lib/nihilc1" > "$work/p.out" || exit 1
        cat "$work/p.out" > "$out" 2>/dev/null && chmod 755 "$out" 2>/dev/null || { echo "nihil: could not create $out" >&2; exit 1; }
    fi
    rm -rf "$work"
    trap - EXIT
}

[ $# -ge 1 ] || usage
case $1 in
    version|--version|-v)
        echo "nihil $(cat "$home/VERSION" 2>/dev/null || echo unknown)"
        ;;
    help|--help|-h)
        sed -n '2,9p' "$self" | sed 's/^# \{0,1\}//'
        ;;
    ide)
        shift
        ide "$@"
        ;;
    run)
        [ $# -ge 2 ] || usage
        src=$2
        shift 2
        dir=$(mktemp -d)
        compile "$src" "$dir/program"
        set +e
        "$dir/program" "$@"
        code=$?
        rm -rf "$dir"
        exit $code
        ;;
    -*)
        usage
        ;;
    *)
        src=$1
        out=${2:-${1%.nihil}}
        [ "$out" != "$src" ] || out=$src.out
        compile "$src" "$out"
        ;;
esac
